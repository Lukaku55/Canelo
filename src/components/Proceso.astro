---
import Icono from './Icono.astro';
import { base, proceso } from '../datos/sitio';
---

<section class="seccion" id="proceso">
	<div class="contenedor">
		<h2>Cómo trabajamos</h2>
		<p class="bajada">Cinco pasos, siempre en el mismo orden. Sabés en cuál estás y qué viene después.</p>

		<ol class="pasos">
			{
				proceso.map((p, i) => (
					<li class="paso">
						<span class="numero" aria-hidden="true">
							{i + 1}
						</span>
						<h3>{p.nombre}</h3>
						<p>{p.texto}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>

<section class="seccion base">
	<div class="contenedor grilla">
		<h2>Todo sitio sale con esto.</h2>
		<ul class="lista">
			{
				base.map((b) => (
					<li>
						<Icono nombre={b.icono} />
						<div>
							<h3>{b.nombre}</h3>
							<p>{b.texto}</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.pasos {
		margin: clamp(2.5rem, 5vw, 4rem) 0 0;
		padding: 0;
		list-style: none;
		border-top: 2px solid var(--tinta);
	}

	.paso {
		display: grid;
		grid-template-columns: 3.5rem 1fr;
		column-gap: 1rem;
		row-gap: 0.35rem;
		padding-block: clamp(1.25rem, 2.5vw, 2rem);
		border-bottom: 1px solid var(--linea);
	}

	.numero {
		grid-row: span 2;
		color: var(--terracota-texto);
		font: 800 clamp(2.5rem, 5vw, 4rem) / 0.9 var(--display);
		letter-spacing: -0.04em;
	}

	.paso p {
		max-width: 52ch;
		color: var(--tinta-suave);
	}

	.base {
		background: var(--oliva);
		color: var(--sobre-oliva);
	}

	.grilla {
		display: grid;
		gap: clamp(2.5rem, 5vw, 4rem);
	}

	.lista {
		display: grid;
		gap: 2rem 2.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.lista li {
		display: flex;
		gap: 1rem;
	}

	.lista :global(.icono) {
		font-size: 1.6rem;
		margin-top: 0.1rem;
	}

	.lista h3 {
		font-size: 1.3125rem;
	}

	.lista p {
		margin-top: 0.35rem;
		color: var(--sobre-oliva-suave);
	}

	@media (min-width: 760px) {
		.paso {
			grid-template-columns: 6rem minmax(12rem, 1fr) 2fr;
			align-items: baseline;
		}

		.numero {
			grid-row: auto;
		}

		.lista {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (min-width: 1000px) {
		.grilla {
			grid-template-columns: 1fr 1.7fr;
		}

		.grilla h2 {
			position: sticky;
			top: 7rem;
			align-self: start;
		}
	}
</style>
