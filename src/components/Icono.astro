---
// Íconos de Phosphor (peso regular), incrustados como SVG.
const iconos = import.meta.glob<string>('/node_modules/@phosphor-icons/core/assets/regular/*.svg', {
	query: '?raw',
	import: 'default',
	eager: true,
});

interface Props {
	nombre: string;
}

const { nombre } = Astro.props;
const svg = iconos[`/node_modules/@phosphor-icons/core/assets/regular/${nombre}.svg`];
if (!svg) throw new Error(`Ícono no encontrado: ${nombre}`);
---

<span class="icono" aria-hidden="true" set:html={svg} />
