---
import '../styles/global.css';
import { PUBLICAR, negocio } from '../datos/sitio';

interface Props {
	titulo: string;
	descripcion?: string;
}

const { titulo, descripcion = negocio.descripcion } = Astro.props;
const canonica = negocio.url ? new URL(Astro.url.pathname, negocio.url).href : null;

const datosEstructurados = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: negocio.nombre,
	description: negocio.descripcion,
	...(negocio.url && { url: negocio.url }),
};
---

<!doctype html>
<html lang="es-AR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{titulo}</title>
		<meta name="description" content={descripcion} />
		{!PUBLICAR && <meta name="robots" content="noindex, nofollow" />}
		{canonica && <link rel="canonical" href={canonica} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#eef0e2" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#161a0f" media="(prefers-color-scheme: dark)" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_AR" />
		<meta property="og:site_name" content={negocio.nombre} />
		<meta property="og:title" content={titulo} />
		<meta property="og:description" content={descripcion} />
		{canonica && <meta property="og:url" content={canonica} />}
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
		<script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />
	</head>
	<body>
		<a class="saltar" href="#contenido">Saltar al contenido</a>
		<slot />
		<script>
			import '../scripts/efectos';
		</script>
	</body>
</html>

<style>
	.saltar {
		position: absolute;
		left: 1rem;
		top: -4rem;
		z-index: 30;
		padding: 0.75rem 1rem;
		border-radius: var(--radio-chico);
		background: var(--tinta);
		color: var(--papel);
	}

	.saltar:focus {
		top: 1rem;
	}
</style>
